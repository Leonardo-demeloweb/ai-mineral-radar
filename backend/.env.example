# ============================================
# MineralRadar Backend — variáveis locais
# ============================================
# O backend carrega, nesta ordem, o primeiro .env encontrado:
#   1. ../.env  (raiz do monorepo — RECOMENDADO)
#   2. backend/.env
#
# Para dev local, prefira um único arquivo na raiz:
#   cp ../.env.example ../.env
#
# Este arquivo serve só para overrides locais do backend.

# OpenSearch local (docker-compose.local.yml — security desabilitado)
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

OPENSEARCH_MCP_ENDPOINT=http://localhost:9200/_plugins/_ml/mcp
