# ============================================
# MineralRadar — Variáveis de Ambiente
# ============================================
# cp env.example .env  →  preencha localmente
# NUNCA versionar .env com credenciais reais!

# ==================== Application ====================
APP_NAME=MineralRadar API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# ==================== Server ====================
HOST=0.0.0.0
PORT=8100

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ==================== Azure AD Authentication ====================
# Obter do Azure Portal > App Registrations
# Deixe AZURE_AD_TENANT_ID vazio (ou comentado) para modo dev sem login Microsoft.
# Valores "your-tenant-id" do exemplo são tratados como não configurados → mesmo bypass.
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
# Audience do access token (Application ID URI no portal Azure), ex.: api://supplyradar
# AZURE_AD_AUDIENCE=api://supplyradar
# Se preencher tenant/cliente real acima e o frontend ainda usar Bearer dev-token:
# AZURE_AD_ALLOW_DEV_BEARER=true

# ==================== OpenSearch ====================
# Local (docker-compose.local.yml — sem SSL):
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
# Timeout de cada request ao OpenSearch (s). Agregações grandes (ex.: CFEM) podem precisar de 90–120.
# OPENSEARCH_TIMEOUT=120
# Timeout do cliente HTTP do API → MCP (JSON-RPC). Deve ser >= OPENSEARCH_TIMEOUT para tools pesadas.
# MCP_JSONRPC_TIMEOUT=120
# MCP_CONNECT_TIMEOUT=10
# Cloud (Oracle / AWS / produção) — descomentar e preencher:
# OPENSEARCH_ENDPOINT=https://seu-cluster:9200
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=sua-senha-segura
# OPENSEARCH_USE_SSL=true
# OPENSEARCH_VERIFY_CERTS=true

# ==================== MongoDB ====================
# Não incluir credenciais na URI — o backend injeta via MONGODB_USER/PASSWORD
# Local (docker-compose.local.yml):
MONGODB_URI=mongodb://localhost:27119
MONGODB_DATABASE=mineralradar
# Cloud (Atlas / Oracle):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# ==================== Redis ====================
# Local (docker-compose.local.yml):
REDIS_HOST=localhost
REDIS_PORT=6479
REDIS_USERNAME=default
REDIS_PASSWORD=mineralradar_redis_local
# Cloud:
# REDIS_HOST=seu-redis.cache.amazonaws.com

# ==================== LLM / Embeddings ====================
# Azure OpenAI (recomendado):
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# OpenAI direto (alternativo):
OPENAI_API_KEY=

# ==================== Azure Maps (geocoding / rotas) ====================
AZURE_MAPS_KEY=

# ==================== Logging ====================
LOG_LEVEL=DEBUG
LOG_FORMAT=console
