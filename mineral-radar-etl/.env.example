# ─────────────────────────────────────────────────────────────────────────────
# MineralRadar ETL — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de subir o stack.
# NUNCA commite o .env real.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=mineralradar
POSTGRES_USER=mineralradar
POSTGRES_PASSWORD=mineralradar_secret
POSTGRES_PORT=5432

# ── pgAdmin (somente dev) ───────────────────────────────────────────────────
PGADMIN_EMAIL=admin@mineralradar.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── OpenSearch ──────────────────────────────────────────────────────────────
# Dev local: security plugin desabilitado (docker-compose.local.yml) — auth opcional
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASS=

# ── Azure OpenAI (embeddings) ───────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://SEU_RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=SUA_CHAVE_AQUI
EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ── ETL ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Checkpoints SICAR/SIGEF e downloads persistem aqui (não usar /tmp)
ETL_DATA_DIR=~/.mineralradar/data

# ── ANM ─────────────────────────────────────────────────────────────────────
ANM_BASE_URL=https://dadosabertos.anm.gov.br
ANM_USER_AGENT=Mozilla/5.0 (compatible; MineralRadarBot/1.0; +https://mineralradar.com.br)

# ── Metais (Metals-API) ──────────────────────────────────────────────────────
METALS_API_KEY=SUA_CHAVE_METALSAPI
