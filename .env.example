# ============================================
# MineralRadar — Variáveis de Ambiente (raiz)
# ============================================
# Copie para .env na raiz do repositório:
#   cp .env.example .env
#
# Usado por: backend (API + MCP + scripts), e como fallback do ETL.
# ETL dedicado: mineral-radar-etl/.env (copie de mineral-radar-etl/.env.example)
# NUNCA commite o .env real.

# ==================== Application ====================
APP_NAME="MineralRadar API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# ==================== Server ====================
HOST=0.0.0.0
PORT=8100

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ==================== Azure AD (opcional em dev) ====================
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ==================== OpenSearch — LOCAL (docker-compose.local.yml) ====================
# Security plugin desabilitado em dev — user/password podem ficar vazios.
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# ==================== MCP Servers ====================
OPENSEARCH_MCP_ENDPOINT=http://localhost:9200/_plugins/_ml/mcp
MCP_JAZIDAS_URL=http://localhost:8110/mcp
MCP_EMPRESAS_URL=http://localhost:8111/mcp
MCP_GEO_URL=http://localhost:8112/mcp

# ==================== MongoDB — LOCAL ====================
MONGODB_URI=mongodb://127.0.0.1:27119
MONGODB_DATABASE=mineralradar
MONGODB_USER=admin
MONGODB_PASSWORD=mineralradar_mongo_local
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=5

# ==================== Redis — LOCAL ====================
REDIS_HOST=localhost
REDIS_PORT=6479
REDIS_USERNAME=default
REDIS_PASSWORD=mineralradar_redis_local

# ==================== Azure Maps (rotas / geocoding) ====================
AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_BASE_URL=https://atlas.microsoft.com

# ==================== LLM / Embeddings (Azure OpenAI) ====================
AZURE_OPENAI_ENDPOINT=https://SEU_RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=seu-deployment-chat
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DEPLOYMENT=seu-deployment-embedding

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FORMAT=console

# ==================== INLABS (DOU — opcional) ====================
INLABS_EMAIL=
INLABS_PASSWORD=

# ==================== Mercado ====================
METALS_API_KEY=
